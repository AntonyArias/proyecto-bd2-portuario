# Copia este archivo a ".env" (en la misma carpeta infra/) y cambia los valores.
# ".env" NUNCA se sube a Git (esta en .gitignore). Usa solo letras, numeros y guion bajo:
# un apostrofe, un $ o un # en la clave romperian el compose o el SQL de inicializacion.
POSTGRES_PASSWORD=cambia_esta_clave
REPL_PASS=cambia_esta_otra_clave
ENC_KEY=cambia_esta_llave_cifrado_2026
AUDITOR_PASS=cambia_clave_auditor_2026
OPERADOR_PASS=cambia_clave_operador_2026
ADMIN_PASS=cambia_clave_admin_2026
